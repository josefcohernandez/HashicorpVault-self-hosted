# Copia este fichero a .env y rellena los valores. .env está en .gitignore.

# Dominio público de Vault (el registro DNS debe existir en Cloudflare)
VAULT_DOMAIN=vault.example.com

# Email registrado en Let's Encrypt (avisos de caducidad)
ACME_EMAIL=

# Token de API de Cloudflare con permisos Zone:DNS:Edit y Zone:Zone:Read sobre la zona
CF_DNS_API_TOKEN=

# Servidor ACME. Usa el de staging mientras pruebas para no agotar los límites de Let's Encrypt:
#   https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Traefik
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_ACCESS_LOG=false

# Scripts
# Número de claves Shamir generadas y umbral necesario para desellar (scripts/init.sh)
VAULT_KEY_SHARES=5
VAULT_KEY_THRESHOLD=3
# Días de retención de snapshots en ./backups (scripts/backup.sh)
BACKUP_RETENTION_DAYS=14
# Días de retención de audit logs rotados (scripts/rotate-audit.sh)
AUDIT_RETENTION_DAYS=30
